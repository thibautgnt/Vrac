    "Still looking, more items may appear": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche en cours, d'autres éléments peuvent apparaître"
          }
        }
      }
    },
    "Technical history of apps and macOS, mostly useful for troubleshooting.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique technique des apps et de macOS, utile surtout pour le dépannage."
          }
        }
      }
    },
    "Temporary files that apps rebuild on their own when needed.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers temporaires que les apps recréent d'elles-mêmes au besoin."
          }
        }
      }
    },
    "Xcode build data, package manager caches and dependencies of idle projects. Archives and idle projects are left unselected.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de compilation Xcode, caches des gestionnaires de paquets et dépendances des projets inactifs. Les archives et les projets inactifs restent décochés."
          }
        }
      }
    },
