    "No caches, logs or leftovers worth removing were found.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun cache, journal ou fichier superflu à supprimer n'a été trouvé."
