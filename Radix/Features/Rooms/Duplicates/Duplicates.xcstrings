    "These copies are APFS clones: they use the space of a single file, so trashing them frees nothing.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces copies sont des clones APFS : elles occupent la place d'un seul fichier, les supprimer ne libère rien."
          }
        }
      }
    },
